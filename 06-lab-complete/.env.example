# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env   (file .env nằm trong .gitignore)
# Trên Railway/Render: đặt các biến này trong dashboard / CLI của nền tảng.
# ============================================================

# Server — Railway/Render tự cấp PORT
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Bảo mật — BẮT BUỘC khi ENVIRONMENT=production. Sinh key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# Redis — state của rate limiter và cost guard
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
